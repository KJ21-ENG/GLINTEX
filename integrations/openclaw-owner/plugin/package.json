{
  "name": "openclaw-plugin-glintex-owner",
  "version": "1.0.3",
  "description": "Owner-only, capability-scoped GLINTEX tools for OpenClaw.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "plugin:validate": "npm run build && npm test",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": "2026.7.1-2"
  },
  "dependencies": {
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "openclaw": "2026.7.1-2",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
