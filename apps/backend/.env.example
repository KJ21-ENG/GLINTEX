DATABASE_URL="postgresql://postgres:password@localhost:5432/glintex_dev"
PORT=4000
GOOGLE_DRIVE_CLIENT_ID="your-google-client-id"
GOOGLE_DRIVE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_DRIVE_REDIRECT_URI="http://localhost:4001/api/google-drive/callback"

# Use this for local (npm) runs so they target your host Postgres on 5432.
# The docker-compose stack exposes its own Postgres on host 5433; leave this
# unchanged to keep the two environments separate and runnable at the same time.

# WhatsApp Web version pinning (stable automation requires a cached HTML file)
WWEBJS_WEB_VERSION="2.3000.1031548524"
WWEBJS_WEB_CACHE_STRICT=true
WWEBJS_WEB_CACHE_PATH="./.wwebjs_cache"

# Dedicated owner-agent API. Generate independent random values for the raw
# OpenClaw token and confirmation secret. Store only the token's SHA-256 hash
# here; the raw token belongs in OpenClaw's mode-0600 credential file.
AGENT_API_PORT=4003
GLINTEX_DEPLOY_SHA="local"
GLINTEX_OWNER_AGENT_DATABASE_URL="postgresql://glintex_owner_agent:replace@db:5432/glintex"
GLINTEX_OWNER_AGENT_ID="glintex-owner"
GLINTEX_OWNER_TELEGRAM_ID="replace-with-verified-numeric-owner-id"
GLINTEX_OWNER_AGENT_TOKEN_SHA256="replace-with-64-character-sha256"
GLINTEX_OWNER_AGENT_CONFIRMATION_SECRET="replace-with-at-least-32-random-characters"
GLINTEX_OWNER_AGENT_SCOPES="app.read,finance.read,system.read,tasks.read,tasks.write,learning.read,learning.propose,operations.read,operations.write,audit.write"
GLINTEX_AGENT_ACTION_TTL_SECONDS=600
