{
  "id": "glintex-readonly",
  "name": "GLINTEX Read Only",
  "description": "Owner-only, bounded read access for the dedicated GLINTEX companion.",
  "version": "1.0.0",
  "configSchema": {
    "type": "object",
    "required": [
      "baseUrl",
      "apiTokenFile",
      "allowedAgentId"
    ],
    "properties": {
      "baseUrl": {
        "type": "string",
        "description": "GLINTEX production base URL."
      },
      "apiTokenFile": {
        "type": "string",
        "description": "Absolute mode-0600 token file."
      },
      "allowedAgentId": {
        "type": "string",
        "minLength": 1
      },
      "requestTimeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 60000,
        "default": 20000
      },
      "maxResponseBytes": {
        "type": "integer",
        "minimum": 65536,
        "maximum": 4194304,
        "default": 2097152
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "glintex_read"
    ]
  }
}
