generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// Side classification for an Item, used by contractor coning rates.
// SINGLE = S/S, BOTH = B/S. UNKNOWN requires manual correction before payments.
enum SideType {
  SINGLE
  BOTH
  UNKNOWN
}

enum PackingPackageKind {
  PACKET
  BOX
  BORI
  PARCEL
}

enum PackingLaunchStatus {
  PREPARATION
  WRITES_GATED
  CUTOVER_APPLIED
  ACTIVE
  FAILED
  REVERSED
}

enum PackingRecipeStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum PackingDeliveryMode {
  UNSPECIFIED
  LOCAL
  PARCEL
}

enum PackingBatchKind {
  INITIAL
  REPACKING
  OPENING
}

enum PackingBatchStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  PARTIALLY_COMPLETED
  COMPLETED
  SHORT_CLOSED
  VOIDED
}

enum PackingBatchSourceType {
  CONING_RECEIVE
  PACKED_UNIT
}

enum PackedUnitStatus {
  IN_PROGRESS
  LABEL_PENDING
  QUALITY_HOLD
  AVAILABLE
  RESERVED
  DISPATCHED
  RETURNED_PENDING_INSPECTION
  DAMAGED
  REPACKED
  SPLIT_CONSUMED
  OPENED
  VOIDED
}

enum PackedUnitEventType {
  BATCH_CONFIRMED
  BATCH_STARTED
  BATCH_TARGET_AMENDED
  BATCH_COMPLETED
  BATCH_SHORT_CLOSED
  BATCH_VOIDED
  SOURCE_RESERVED
  SOURCE_CONSUMED
  SOURCE_RELEASED
  UNIT_SEALED
  UNIT_LABEL_PENDING
  UNIT_LABEL_REPRINTED
  UNIT_BARCODE_REPLACED
  UNIT_QUALITY_RELEASED
  UNIT_RESERVED
  UNIT_RESERVATION_RELEASED
  UNIT_RESERVATION_REASSIGNED
  UNIT_SPLIT
  UNIT_RETURNED
  UNIT_RETURN_INSPECTED
  UNIT_DAMAGED
  UNIT_WRITTEN_OFF
  UNIT_REPACKED
  ADMINISTRATIVE_AMENDMENT
  EVENT_REVERSED
}

enum DispatchChallanStatus {
  ACTIVE
  VOIDED
  PARTIALLY_RETURNED
  RETURNED
}

enum DispatchSourceType {
  INBOUND
  CUTTER
  HOLO
  PACKED
}

enum DispatchEventType {
  CHALLAN_CREATED
  CHALLAN_VOIDED
  LINE_CORRECTED
  LINE_RETURNED
  RETURN_REVERSED
  DISPATCH_EVENT_REVERSED
}

enum DispatchDocumentKind {
  ORIGINAL
  LEGACY_RECONSTRUCTION
}

enum InventoryAdjustmentKind {
  LEGACY_CUTOVER
  MANUAL_CORRECTION
  DAMAGE_WRITE_OFF
  OPENING_BALANCE
}

enum InventoryAdjustmentStatus {
  DRAFT
  APPLIED
  REVERSED
  FAILED
}

model Item {
  id              String   @id @default(cuid())
  name            String
  side            SideType @default(UNKNOWN)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  lots            Lot[]
  packingRecipes  PackingRecipe[]
  packedUnits     PackedUnit[]
}

model Yarn {
  id                     String                  @id @default(cuid())
  name                   String                  @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @default(now()) @updatedAt
  createdByUserId        String?
  updatedByUserId        String?
  issues                 IssueToHoloMachine[]
  coningIssues           IssueToConingMachine[]
  holoProductionPerHours HoloProductionPerHour[]
}

model Cut {
  id                     String                        @id @default(cuid())
  name                   String                        @unique
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @default(now()) @updatedAt
  createdByUserId        String?
  updatedByUserId        String?
  receiveRows            ReceiveFromCutterMachineRow[]
  cutterIssues           IssueToCutterMachine[]
  holoIssues             IssueToHoloMachine[]
  coningIssues           IssueToConingMachine[]
  holoProductionPerHours HoloProductionPerHour[]
}

model Twist {
  id              String                  @id @default(cuid())
  name            String                  @unique
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  holoIssues      IssueToHoloMachine[]
  coningIssues    IssueToConingMachine[]
  machineMappings MachineTwistMapping[]
}

model MachineTwistMapping {
  id              String   @id @default(cuid())
  machineId       String   @unique
  twistId         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  machine         Machine  @relation(fields: [machineId], references: [id])
  twist           Twist    @relation(fields: [twistId], references: [id])

  @@index([twistId])
}

model Firm {
  id              String   @id @default(cuid())
  name            String
  address         String?
  mobile          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  lots            Lot[]
}

model Supplier {
  id              String   @id @default(cuid())
  name            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  lots            Lot[]
}

model Lot {
  id              String    @id @default(cuid())
  lotNo           String    @unique
  date            String
  itemId          String
  firmId          String?
  supplierId      String?
  totalPieces     Int
  totalWeight     Float
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  item            Item      @relation(fields: [itemId], references: [id])
  firm            Firm?     @relation(fields: [firmId], references: [id])
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
}

model InboundItem {
  id                   String   @id
  lotNo                String
  itemId               String
  weight               Float
  status               String
  note                 String?
  seq                  Int
  barcode              String   @unique
  consumptionDate      String?
  isOpeningStock       Boolean  @default(false)
  dispatchedWeight     Float    @default(0)
  issuedToCutterWeight Float    @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
  createdByUserId      String?
  updatedByUserId      String?
}

model Machine {
  id                    String                 @id @default(cuid())
  name                  String
  processType           String                 @default("all")
  spindle               Int?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @default(now()) @updatedAt
  createdByUserId       String?
  updatedByUserId       String?
  issueToCutterMachines IssueToCutterMachine[]
  issueToHoloMachines   IssueToHoloMachine[]
  issueToConingMachines IssueToConingMachine[]
  boilerSteamLogs       BoilerSteamLog[]       @relation("BoilerSteamLogMachine")
  twistMapping          MachineTwistMapping?
}

model Operator {
  id                    String                        @id @default(cuid())
  name                  String
  role                  String                        @default("operator")
  processType           String                        @default("all")
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @default(now()) @updatedAt
  createdByUserId       String?
  updatedByUserId       String?
  issueToCutterMachines IssueToCutterMachine[]
  receiveRows           ReceiveFromCutterMachineRow[] @relation("OperatorReceiveRows")
  helperRows            ReceiveFromCutterMachineRow[] @relation("HelperReceiveRows")
  holoIssues            IssueToHoloMachine[]          @relation("IssueToHoloOperator")
  coningIssues          IssueToConingMachine[]        @relation("IssueToConingOperator")
  holoReceiveRows       ReceiveFromHoloMachineRow[]   @relation("OperatorHoloReceive")
  holoHelperRows        ReceiveFromHoloMachineRow[]   @relation("HelperHoloReceive")
  coningReceiveRows     ReceiveFromConingMachineRow[] @relation("OperatorConingReceive")
  coningHelperRows      ReceiveFromConingMachineRow[] @relation("HelperConingReceive")
}

model Bobbin {
  id              String                        @id @default(cuid())
  name            String
  weight          Float? // Weight in kg (BoxWt)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  receiveRows     ReceiveFromCutterMachineRow[]
}

model IssueToHoloMachine {
  id                    String                      @id @default(cuid())
  date                  String
  itemId                String
  lotNo                 String
  yarnId                String?
  twistId               String?
  machineId             String?
  operatorId            String?
  cutId                 String?
  barcode               String                      @unique
  note                  String?
  shift                 String?
  metallicBobbins       Int                         @default(0)
  metallicBobbinsWeight Float                       @default(0)
  yarnKg                Float                       @default(0)
  receivedRowRefs       Json                        @default("[]")
  rollsProducedEstimate Int?
  isDeleted             Boolean                     @default(false)
  deletedAt             DateTime?
  deletedByUserId       String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @default(now()) @updatedAt
  createdByUserId       String?
  updatedByUserId       String?
  machine               Machine?                    @relation(fields: [machineId], references: [id])
  operator              Operator?                   @relation("IssueToHoloOperator", fields: [operatorId], references: [id])
  yarn                  Yarn?                       @relation(fields: [yarnId], references: [id])
  twist                 Twist?                      @relation(fields: [twistId], references: [id])
  cut                   Cut?                        @relation(fields: [cutId], references: [id])
  receiveRows           ReceiveFromHoloMachineRow[] @relation("IssueHoloRelation")

  @@index([isDeleted, createdAt])
}

model ReceiveFromHoloMachineRow {
  id               String             @id @default(cuid())
  date             String?
  issueId          String
  pieceId          String?
  rollCount        Int
  rollWeight       Float?
  rollTypeId       String?
  grossWeight      Float?
  tareWeight       Float?
  barcode          String?            @unique
  boxId            String?
  machineNo        String?
  operatorId       String?
  helperId         String?
  notes            String?
  createdBy        String?
  isDeleted        Boolean            @default(false)
  deletedAt        DateTime?
  deletedByUserId  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now()) @updatedAt
  createdByUserId  String?
  updatedByUserId  String?
  dispatchedWeight Float              @default(0)
  dispatchedCount  Int                @default(0)
  issue            IssueToHoloMachine @relation("IssueHoloRelation", fields: [issueId], references: [id])
  rollType         RollType?          @relation(fields: [rollTypeId], references: [id])
  box              Box?               @relation(fields: [boxId], references: [id])
  operator         Operator?          @relation("OperatorHoloReceive", fields: [operatorId], references: [id])
  helper           Operator?          @relation("HelperHoloReceive", fields: [helperId], references: [id])

  @@index([issueId, isDeleted])
}

model ReceiveFromHoloMachinePieceTotal {
  pieceId            String   @id
  totalRolls         Int      @default(0)
  totalNetWeight     Float    @default(0)
  wastageNetWeight   Float    @default(0)
  lastWastageEventId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdByUserId    String?
  updatedByUserId    String?
}

model HoloDailyMetric {
  id              String   @id @default(cuid())
  date            String
  baseMachine     String
  hours           Float?
  wastage         Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?

  @@unique([date, baseMachine])
}

model HoloOtherWastageItem {
  id              String                   @id @default(cuid())
  name            String                   @unique
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  metrics         HoloOtherWastageMetric[]
}

model HoloOtherWastageMetric {
  id                 String               @id @default(cuid())
  date               String
  otherWastageItemId String
  wastage            Float
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt
  createdByUserId    String?
  updatedByUserId    String?
  otherWastageItem   HoloOtherWastageItem @relation(fields: [otherWastageItemId], references: [id])

  @@unique([date, otherWastageItemId])
}

model RollType {
  id              String                      @id @default(cuid())
  name            String                      @unique
  weight          Float?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  receiveRows     ReceiveFromHoloMachineRow[]
}

model HoloProductionPerHour {
  id                  String   @id @default(cuid())
  yarnId              String
  cutId               String?
  cutMatcher          String
  productionPerHourKg Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
  createdByUserId     String?
  updatedByUserId     String?
  yarn                Yarn     @relation(fields: [yarnId], references: [id])
  cut                 Cut?     @relation(fields: [cutId], references: [id])

  @@unique([yarnId, cutMatcher])
  @@index([cutId])
}

model ConeType {
  id              String   @id @default(cuid())
  name            String   @unique
  weight          Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  packingRecipes  PackingRecipe[]
  packedUnits     PackedUnit[]
}

model Wrapper {
  id              String   @id @default(cuid())
  name            String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  packingRecipes  PackingRecipe[]
  packedUnits     PackedUnit[]
}

model StickerTemplate {
  id              String   @id @default(cuid())
  stageKey        String   @unique
  dimensions      Json
  content         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?
  updatedByUserId String?
}

model IssueToConingMachine {
  id                       String                        @id @default(cuid())
  date                     String
  itemId                   String
  lotNo                    String
  yarnId                   String?
  twistId                  String?
  cutId                    String?
  machineId                String?
  operatorId               String?
  barcode                  String                        @unique
  note                     String?
  shift                    String?
  rollsIssued              Int                           @default(0)
  requiredPerConeNetWeight Float                         @default(0)
  expectedCones            Float                         @default(0)
  receivedRowRefs          Json                          @default("[]")
  isDeleted                Boolean                       @default(false)
  deletedAt                DateTime?
  deletedByUserId          String?
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @default(now()) @updatedAt
  createdByUserId          String?
  updatedByUserId          String?
  machine                  Machine?                      @relation(fields: [machineId], references: [id])
  operator                 Operator?                     @relation("IssueToConingOperator", fields: [operatorId], references: [id])
  yarn                     Yarn?                         @relation(fields: [yarnId], references: [id])
  twist                    Twist?                        @relation(fields: [twistId], references: [id])
  cut                      Cut?                          @relation(fields: [cutId], references: [id])
  receiveRows              ReceiveFromConingMachineRow[] @relation("IssueConingRelation")

  @@index([isDeleted, createdAt])
}

model ReceiveFromConingMachineRow {
  id               String               @id @default(cuid())
  barcode          String?              @unique
  date             String?
  issueId          String
  coneCount        Int
  coneWeight       Float?
  netWeight        Float?
  tareWeight       Float?
  grossWeight      Float?
  // Source consumption breakdown (holo receive row refs). Stored on receive to avoid FIFO guessing later.
  sourceRowRefs    Json                 @default("[]")
  boxId            String?
  machineNo        String?
  operatorId       String?
  helperId         String?
  notes            String?
  createdBy        String?
  isDeleted        Boolean              @default(false)
  isOpeningStock   Boolean              @default(false)
  deletedAt        DateTime?
  deletedByUserId  String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @default(now()) @updatedAt
  createdByUserId  String?
  updatedByUserId  String?
  issue            IssueToConingMachine @relation("IssueConingRelation", fields: [issueId], references: [id])
  operator         Operator?            @relation("OperatorConingReceive", fields: [operatorId], references: [id])
  helper           Operator?            @relation("HelperConingReceive", fields: [helperId], references: [id])
  box              Box?                 @relation(fields: [boxId], references: [id])
  dispatchedWeight Float                @default(0)
  dispatchedCount  Int                  @default(0)

  @@index([issueId, isDeleted])
}

model ReceiveFromConingMachinePieceTotal {
  pieceId            String   @id
  totalCones         Int      @default(0)
  totalNetWeight     Float    @default(0)
  wastageNetWeight   Float    @default(0)
  lastWastageEventId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdByUserId    String?
  updatedByUserId    String?
}

model IssueToCutterMachine {
  id              String                        @id
  date            String
  itemId          String
  lotNo           String
  cutId           String?
  count           Int
  totalWeight     Float
  pieceIds        String
  reason          String
  note            String?
  machineId       String?
  operatorId      String?
  barcode         String                        @unique
  isDeleted       Boolean                       @default(false)
  deletedAt       DateTime?
  deletedByUserId String?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  cut             Cut?                          @relation(fields: [cutId], references: [id])
  machine         Machine?                      @relation(fields: [machineId], references: [id])
  operator        Operator?                     @relation(fields: [operatorId], references: [id])
  lines           IssueToCutterMachineLine[]
  receiveRows     ReceiveFromCutterMachineRow[]
}

model IssueToCutterMachineLine {
  id              String               @id @default(cuid())
  issueId         String
  pieceId         String
  issuedWeight    Float                @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  issue           IssueToCutterMachine @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, pieceId])
  @@index([issueId])
  @@index([pieceId])
}

model ReceiveFromCutterMachineUpload {
  id               String                        @id @default(cuid())
  originalFilename String
  uploadedAt       DateTime                      @default(now())
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @default(now()) @updatedAt
  createdByUserId  String?
  updatedByUserId  String?
  rowCount         Int                           @default(0)
  rows             ReceiveFromCutterMachineRow[]
}

model ReceiveFromCutterMachineRow {
  id                 String                           @id @default(cuid())
  uploadId           String
  issueId            String?
  pieceId            String
  vchNo              String                           @unique
  narration          String?
  date               String?
  vchBook            String?
  barcode            String?
  shift              String?
  godownName         String?
  racNo              String?
  prodIssType        String?
  yarnName           String?
  itemName           String?
  cut                String?
  machineNo          String?
  employee           String?
  pktTypeName        String?
  pcsTypeName        String?
  bobbinId           String?
  boxId              String?
  operatorId         String?
  helperId           String?
  helperName         String?
  notes              String?
  bobbinQuantity     Int?                             @map("bobbin_quantity")
  issuedBobbins      Int                              @default(0)
  issuedBobbinWeight Float                            @default(0)
  grossWt            Float?
  tareWt             Float?
  netWt              Float?
  pktBoxWt           Float?
  pcsBoxWt           Float?
  yarnWt             Float?
  totalKg            Float?
  createdBy          String?
  modifiedBy         String?
  challanId          String?
  isDeleted          Boolean                          @default(false)
  deletedAt          DateTime?
  deletedByUserId    String?
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @default(now()) @updatedAt
  createdByUserId    String?
  updatedByUserId    String?
  upload             ReceiveFromCutterMachineUpload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  challan            ReceiveFromCutterMachineChallan? @relation(fields: [challanId], references: [id])
  bobbin             Bobbin?                          @relation(fields: [bobbinId], references: [id])
  box                Box?                             @relation(fields: [boxId], references: [id])
  operator           Operator?                        @relation("OperatorReceiveRows", fields: [operatorId], references: [id])
  helper             Operator?                        @relation("HelperReceiveRows", fields: [helperId], references: [id])
  cutId              String?
  cutMaster          Cut?                             @relation(fields: [cutId], references: [id])
  issue              IssueToCutterMachine?            @relation(fields: [issueId], references: [id])
  dispatchedWeight   Float                            @default(0)
  dispatchedCount    Int                              @default(0)

  @@index([issueId, isDeleted])
  @@index([pieceId, isDeleted])
}

model ReceiveFromCutterMachineChallan {
  id               String                        @id @default(cuid())
  challanNo        String                        @unique
  sequence         Int
  fiscalYear       String
  pieceId          String
  lotNo            String
  itemId           String?
  date             String?
  totalNetWeight   Float                         @default(0)
  totalBobbinQty   Int                           @default(0)
  operatorId       String?
  helperId         String?
  cutId            String?
  wastageNetWeight Float                         @default(0)
  wastageNote      String?
  changeLog        Json                          @default("[]")
  isDeleted        Boolean                       @default(false)
  deletedAt        DateTime?
  deletedByUserId  String?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @default(now()) @updatedAt
  createdByUserId  String?
  updatedByUserId  String?
  rows             ReceiveFromCutterMachineRow[]

  @@index([pieceId, isDeleted])
}

model ReceiveFromCutterMachinePieceTotal {
  pieceId            String   @id
  totalNetWeight     Float    @default(0)
  totalBob           Int      @default(0)
  wastageNetWeight   Float    @default(0)
  lastWastageEventId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdByUserId    String?
  updatedByUserId    String?
}

model Settings {
  id                  Int      @id @default(1)
  brandPrimary        String
  brandGold           String
  logoDataUrl         String?
  faviconDataUrl      String?
  whatsappEnabled     Boolean  @default(true)
  whatsappNumber      String?
  whatsappGroupIds    String[] @default([])
  telegramEnabled     Boolean  @default(false)
  telegramBotToken    String?
  telegramChatIds     String[] @default([])
  backupTime          String   @default("03:00")
  challanFromName     String?
  challanFromAddress  String?
  challanFromMobile   String?
  challanFieldsConfig Json     @default("{}")
  autoSelectTwistForMachine Boolean @default(false)

  // Telegram Cron Configuration
  telegramCronEnabled         Boolean  @default(false)
  telegramCronSchedule        String   @default("30 10 * * 4,6")
  telegramCronChatId          String?
  telegramCronMessage         String?
  telegramCronReminderEnabled Boolean  @default(false)
  telegramCronReminderTime    String   @default("14:00")
  telegramCronReminderMessage String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
  createdByUserId     String?
  updatedByUserId     String?
}

model TelegramCronLog {
  id                String    @id @default(cuid())
  date              String    @unique // Format: "YYYY-MM-DD"
  initialSentAt     DateTime?
  initialMessageId  Int?
  reminderSentAt    DateTime?
  responseDetected  Boolean   @default(false)
  responseText      String?
  responseUser      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
}

model GoogleDriveCredential {
  id           Int       @id @default(1)
  refreshToken String
  accessToken  String?
  tokenExpiry  DateTime?
  email        String?
  folderId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
}

model Sequence {
  id              String   @id @default("lot_sequence")
  nextValue       Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
}

model HoloIssueSequence {
  id              String   @id @default("holo_issue_seq")
  nextValue       Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
}

model ConingIssueSequence {
  id              String   @id @default("coning_issue_seq")
  nextValue       Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
}

model WhatsappTemplate {
  id              Int      @id @default(autoincrement())
  event           String   @unique
  enabled         Boolean  @default(true)
  template        String
  sendToPrimary   Boolean  @default(true)
  groupIds        String[] @default([])
  telegramChatIds String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
}

model Box {
  id                String                        @id @default(cuid())
  name              String
  weight            Float
  processType       String                        @default("all")
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @default(now()) @updatedAt
  createdByUserId   String?
  updatedByUserId   String?
  receiveRows       ReceiveFromCutterMachineRow[]
  holoReceiveRows   ReceiveFromHoloMachineRow[]
  coningReceiveRows ReceiveFromConingMachineRow[]
}

model AuditLog {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String?
  action        String
  actorUserId   String?
  actorUsername String?
  actorRoleKey  String?
  payload       Json?
  payloadText   String?
  createdAt     DateTime @default(now())
}

model NotificationDeliveryLog {
  id              String   @id @default(cuid())
  event           String?
  templateEvent   String?
  templateId      Int?
  source          String?
  channel         String
  recipient       String?
  recipientType   String?
  status          String
  reason          String?
  error           String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([event, createdAt])
  @@index([channel, createdAt])
}

model Role {
  id              String     @id @default(cuid())
  key             String     @unique
  name            String
  description     String?
  permissions     Json       @default("{}")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  users           UserRole[]
}

model User {
  id              String        @id @default(cuid())
  username        String        @unique
  displayName     String?
  passwordHash    String
  isActive        Boolean       @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  roles           UserRole[]
  sessions        UserSession[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  ip         String?
  userAgent  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ========== DISPATCH FEATURE ==========

model Customer {
  id               String            @id @default(cuid())
  name             String
  phone            String?
  address          String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  createdByUserId  String?
  updatedByUserId  String?
  dispatches       Dispatch[]
  documentMessages DocumentMessage[]
  packingRecipes   PackingRecipe[]
  packingBatches   PackingBatch[]
  packedUnits      PackedUnit[]
  dispatchChallans DispatchChallan[]

  @@index([isActive])
}

model OperationalSequence {
  key       String   @id
  nextValue Int      @default(1)
  updatedAt DateTime @default(now()) @updatedAt
}

model PackingColor {
  id              String        @id @default(cuid())
  name            String
  normalizedName  String        @unique
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  recipes         PackingRecipe[]
  packedUnits     PackedUnit[]

  @@index([isActive, name])
}

model PackingPackageType {
  id              String                @id @default(cuid())
  name            String
  normalizedName  String                @unique
  kind            PackingPackageKind
  defaultTareKg   Decimal               @db.Decimal(12, 3)
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  recipeLevels    PackingRecipeLevel[]
  packedUnits     PackedUnit[]

  @@index([kind, isActive])
  @@index([isActive, name])
}

model PackingLaunchState {
  id                   String                    @id @default("packing_dispatch_v2")
  status               PackingLaunchStatus       @default(PREPARATION)
  affectedWritesPaused Boolean                   @default(false)
  cutoffAt             DateTime?
  adjustmentBatchId    String?                   @unique
  lastError            String?
  updatedAt            DateTime                  @default(now()) @updatedAt
  updatedByUserId      String?
  adjustmentBatch      InventoryAdjustmentBatch? @relation(fields: [adjustmentBatchId], references: [id], onDelete: SetNull)
}

model PackingRecipe {
  id                      String               @id @default(cuid())
  familyKey               String
  version                 Int
  status                  PackingRecipeStatus  @default(DRAFT)
  supersedesRecipeId      String?
  itemId                  String?
  wrapperId               String?
  colorId                 String?
  coneTypeId              String?
  customerId              String?
  nominalGram             Decimal?             @db.Decimal(12, 3)
  deliveryMode            PackingDeliveryMode  @default(UNSPECIFIED)
  allowPartialDispatch    Boolean              @default(false)
  requiresQualityHold     Boolean              @default(false)
  warningVariancePercent  Decimal              @default(2.000) @db.Decimal(12, 3)
  approvalVariancePercent Decimal              @default(5.000) @db.Decimal(12, 3)
  stockUnitLevelIndex     Int
  notes                   String?
  sourceMetadata          Json?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @default(now()) @updatedAt
  createdByUserId         String?
  updatedByUserId         String?
  supersedesRecipe        PackingRecipe?      @relation("PackingRecipeSupersedes", fields: [supersedesRecipeId], references: [id], onDelete: SetNull)
  supersededBy            PackingRecipe[]     @relation("PackingRecipeSupersedes")
  item                    Item?               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  wrapper                 Wrapper?            @relation(fields: [wrapperId], references: [id], onDelete: Restrict)
  color                   PackingColor?       @relation(fields: [colorId], references: [id], onDelete: Restrict)
  coneType                ConeType?           @relation(fields: [coneTypeId], references: [id], onDelete: Restrict)
  customer                Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  levels                  PackingRecipeLevel[]
  batches                 PackingBatch[]
  packedUnits             PackedUnit[]

  @@unique([familyKey, version])
  @@index([familyKey, status])
  @@index([status, updatedAt])
  @@index([itemId, wrapperId, colorId, coneTypeId])
  @@index([customerId, status])
  @@index([supersedesRecipeId])
}

model PackingRecipeLevel {
  id                     String             @id @default(cuid())
  recipeId               String
  levelIndex             Int
  packageTypeId          String
  childUnitsPerContainer Int
  barcodeEnabled         Boolean            @default(false)
  recipe                 PackingRecipe      @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  packageType            PackingPackageType @relation(fields: [packageTypeId], references: [id], onDelete: Restrict)

  @@unique([recipeId, levelIndex])
  @@index([packageTypeId])
}

model PackingBatch {
  id                    String              @id @default(cuid())
  batchNo               String              @unique
  kind                  PackingBatchKind
  status                PackingBatchStatus  @default(DRAFT)
  recipeId              String
  recipeSnapshot        Json
  customerId            String?
  deliveryMode          PackingDeliveryMode @default(UNSPECIFIED)
  plannedBaseCount      Int
  plannedNetWeightKg    Decimal             @db.Decimal(16, 3)
  targetAmendmentReason String?
  shortCloseReason      String?
  voidReason            String?
  notes                 String?
  confirmedAt           DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  shortClosedAt         DateTime?
  voidedAt              DateTime?
  version               Int                 @default(1)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @default(now()) @updatedAt
  createdByUserId       String?
  updatedByUserId       String?
  recipe                PackingRecipe       @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  customer              Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sources               PackingBatchSource[]
  units                 PackedUnit[]
  events                PackedUnitEvent[]

  @@index([status, createdAt])
  @@index([recipeId, status])
  @@index([customerId, status])
  @@index([kind, status])
}

model PackingBatchSource {
  id                     String                 @id @default(cuid())
  batchId                String
  sourceType             PackingBatchSourceType
  sourceId               String
  sourceBarcode          String?
  sourceItemSnapshot     Json                   @default("{}")
  sourceLotSnapshot      Json                   @default("{}")
  sourceRecipeSnapshot   Json                   @default("{}")
  sourceCustomerSnapshot Json                   @default("{}")
  reservedBaseCount      Int
  reservedNetWeightKg    Decimal                @db.Decimal(16, 3)
  consumedBaseCount      Int                    @default(0)
  consumedNetWeightKg    Decimal                @default(0) @db.Decimal(16, 3)
  releasedBaseCount      Int                    @default(0)
  releasedNetWeightKg    Decimal                @default(0) @db.Decimal(16, 3)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @default(now()) @updatedAt
  createdByUserId        String?
  updatedByUserId        String?
  batch                  PackingBatch           @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([batchId])
  @@index([sourceType, sourceId])
  @@index([sourceBarcode])
}

model PackedUnit {
  id                String            @id @default(cuid())
  batchId           String
  recipeId          String
  packageTypeId     String
  parentUnitId      String?
  levelIndex        Int
  unitSequence      Int
  barcode           String?           @unique
  isStockUnit       Boolean
  status            PackedUnitStatus  @default(IN_PROGRESS)
  itemId            String
  wrapperId         String
  colorId           String
  coneTypeId        String
  customerId        String?
  nominalGram       Decimal           @db.Decimal(12, 3)
  baseCount         Int
  grossWeightKg     Decimal           @db.Decimal(16, 3)
  tareWeightKg      Decimal           @db.Decimal(16, 3)
  netWeightKg       Decimal           @db.Decimal(16, 3)
  labelPrintCount   Int               @default(0)
  sealedAt          DateTime?
  qualityReleasedAt DateTime?
  splitFromUnitId   String?
  replacedByUnitId  String?
  version           Int               @default(1)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt
  createdByUserId   String?
  updatedByUserId   String?
  batch             PackingBatch      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  recipe            PackingRecipe     @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  packageType       PackingPackageType @relation(fields: [packageTypeId], references: [id], onDelete: Restrict)
  parentUnit        PackedUnit?       @relation("PackedUnitHierarchy", fields: [parentUnitId], references: [id], onDelete: Restrict)
  childUnits        PackedUnit[]      @relation("PackedUnitHierarchy")
  item              Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  wrapper           Wrapper           @relation(fields: [wrapperId], references: [id], onDelete: Restrict)
  color             PackingColor      @relation(fields: [colorId], references: [id], onDelete: Restrict)
  coneType          ConeType          @relation(fields: [coneTypeId], references: [id], onDelete: Restrict)
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  splitFromUnit     PackedUnit?       @relation("PackedUnitSplit", fields: [splitFromUnitId], references: [id], onDelete: Restrict)
  splitChildren     PackedUnit[]      @relation("PackedUnitSplit")
  replacedByUnit    PackedUnit?       @relation("PackedUnitReplacement", fields: [replacedByUnitId], references: [id], onDelete: Restrict)
  replacementUnits  PackedUnit[]      @relation("PackedUnitReplacement")
  events            PackedUnitEvent[]
  dispatchLines     DispatchLine[]

  @@unique([batchId, levelIndex, unitSequence])
  @@index([batchId, levelIndex])
  @@index([parentUnitId])
  @@index([status, isStockUnit])
  @@index([customerId, status])
  @@index([itemId, status])
  @@index([recipeId, status])
  @@index([splitFromUnitId])
  @@index([replacedByUnitId])
  @@index([createdAt])
}

model PackedUnitEvent {
  id                String              @id @default(cuid())
  batchId           String?
  unitId            String?
  type              PackedUnitEventType
  reason            String?
  payload           Json                @default("{}")
  reversalOfEventId String?             @unique
  idempotencyKey    String              @unique
  actorUserId       String?
  createdAt         DateTime            @default(now())
  batch             PackingBatch?       @relation(fields: [batchId], references: [id], onDelete: Restrict)
  unit              PackedUnit?         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  reversalOfEvent   PackedUnitEvent?    @relation("PackedUnitEventReversal", fields: [reversalOfEventId], references: [id], onDelete: Restrict)
  reversalEvents    PackedUnitEvent[]   @relation("PackedUnitEventReversal")

  @@index([batchId, createdAt])
  @@index([unitId, createdAt])
  @@index([type, createdAt])
}

// Document messages sent via WhatsApp - stores only metadata, no file content
model DocumentMessage {
  id              String   @id @default(cuid())
  customerId      String
  phone           String // Recipient phone at send time
  filename        String // Original filename
  mimetype        String // e.g. 'image/jpeg', 'application/pdf'
  fileSize        Int? // File size in bytes (optional)
  caption         String? // Optional message caption
  sentAt          DateTime @default(now())
  createdByUserId String?
  customer        Customer @relation(fields: [customerId], references: [id])
}

model DispatchSequence {
  id        String   @id // Format: "dispatch_seq_2025_26"
  nextValue Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Dispatch {
  id              String   @id @default(cuid())
  challanNo       String // Format: DC/2025-26/001
  date            String
  customerId      String
  stage           String // "inbound" | "cutter" | "holo" | "coning"
  stageItemId     String // ID of the source item
  stageBarcode    String // Original barcode of the dispatched item
  weight          Float
  count           Int? // Number of pieces dispatched (nullable for backward compat)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  customer        Customer @relation(fields: [customerId], references: [id])
  v2Line          DispatchLine?
}

model DispatchChallan {
  id                     String                @id @default(cuid())
  challanNo              String                @unique
  businessDate           DateTime              @db.Date
  customerId             String
  status                 DispatchChallanStatus @default(ACTIVE)
  notes                  String?
  companySnapshot        Json
  customerSnapshot       Json
  idempotencyKey         String                @unique
  isLegacyReconstruction Boolean               @default(false)
  version                Int                   @default(1)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @default(now()) @updatedAt
  createdByUserId        String?
  updatedByUserId        String?
  customer               Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines                  DispatchLine[]
  events                 DispatchEvent[]
  document               DispatchDocument?

  @@index([businessDate])
  @@index([customerId, status, businessDate])
  @@index([status, createdAt])
}

model DispatchLine {
  id                    String            @id @default(cuid())
  challanId             String
  sourceType            DispatchSourceType
  sourceId              String
  sourceBarcode         String?
  sourceDisplaySnapshot Json              @default("{}")
  baseCount             Int?
  netWeightKg           Decimal           @db.Decimal(16, 3)
  parentPackedUnitId    String?
  legacyDispatchId      String?           @unique
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @default(now()) @updatedAt
  createdByUserId       String?
  updatedByUserId       String?
  challan               DispatchChallan   @relation(fields: [challanId], references: [id], onDelete: Restrict)
  parentPackedUnit      PackedUnit?       @relation(fields: [parentPackedUnitId], references: [id], onDelete: Restrict)
  legacyDispatch        Dispatch?         @relation(fields: [legacyDispatchId], references: [id], onDelete: Restrict)
  events                DispatchEvent[]

  @@index([challanId])
  @@index([sourceType, sourceId])
  @@index([sourceBarcode])
  @@index([parentPackedUnitId])
  @@index([createdAt])
}

model DispatchEvent {
  id                String           @id @default(cuid())
  challanId         String?
  lineId            String?
  type              DispatchEventType
  reason            String?
  payload           Json             @default("{}")
  reversalOfEventId String?          @unique
  idempotencyKey    String           @unique
  actorUserId       String?
  createdAt         DateTime         @default(now())
  challan           DispatchChallan? @relation(fields: [challanId], references: [id], onDelete: Restrict)
  line              DispatchLine?    @relation(fields: [lineId], references: [id], onDelete: Restrict)
  reversalOfEvent   DispatchEvent?   @relation("DispatchEventReversal", fields: [reversalOfEventId], references: [id], onDelete: Restrict)
  reversalEvents    DispatchEvent[]  @relation("DispatchEventReversal")

  @@index([challanId, createdAt])
  @@index([lineId, createdAt])
  @@index([type, createdAt])
}

model DispatchDocument {
  id                String              @id @default(cuid())
  challanId         String              @unique
  kind              DispatchDocumentKind
  renderingSnapshot Json
  pdfBytes          Bytes?
  sha256Hash        String?
  generatedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  challan           DispatchChallan     @relation(fields: [challanId], references: [id], onDelete: Restrict)
}

model InventoryAdjustmentBatch {
  id               String                    @id @default(cuid())
  batchNo          String                    @unique
  kind             InventoryAdjustmentKind
  status           InventoryAdjustmentStatus @default(DRAFT)
  effectiveAt      DateTime
  reason           String
  evidenceSnapshot Json
  idempotencyKey   String                    @unique
  appliedAt        DateTime?
  reversedAt       DateTime?
  appliedByUserId  String?
  reversedByUserId String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @default(now()) @updatedAt
  createdByUserId  String?
  updatedByUserId  String?
  lines            InventoryAdjustmentLine[]
  launchState      PackingLaunchState?

  @@index([status, effectiveAt])
  @@index([kind, status])
  @@index([createdAt])
}

model InventoryAdjustmentLine {
  id                  String                    @id @default(cuid())
  batchId             String
  sourceType          String
  sourceId            String
  countDelta          Int
  weightDeltaKg       Decimal                   @db.Decimal(16, 3)
  sourceBarcode       String?
  sourceItemSnapshot  Json                      @default("{}")
  sourceLotSnapshot   Json                      @default("{}")
  sourceConeSnapshot  Json                      @default("{}")
  replacementSourceId String?
  replacementUnitId   String?
  reversalOfLineId    String?                   @unique
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @default(now()) @updatedAt
  createdByUserId     String?
  updatedByUserId     String?
  batch               InventoryAdjustmentBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  reversalOfLine      InventoryAdjustmentLine?  @relation("InventoryAdjustmentLineReversal", fields: [reversalOfLineId], references: [id], onDelete: Restrict)
  reversalLines       InventoryAdjustmentLine[] @relation("InventoryAdjustmentLineReversal")

  @@index([batchId])
  @@index([sourceType, sourceId])
  @@index([sourceBarcode])
  @@index([replacementSourceId])
  @@index([replacementUnitId])
}

// ========== BOX TRANSFER FEATURE ==========

model BoxTransfer {
  id                String       @id @default(cuid())
  date              String
  stage             String // "holo" | "coning" | "cutter"
  fromBarcode       String
  fromItemId        String // ID of source receive row
  toBarcode         String
  toItemId          String // ID of destination receive row
  pieceCount        Int // Number of pieces transferred
  weightTransferred Float // Net weight transferred
  notes             String?
  isReversed        Boolean      @default(false)
  reversedById      String?      @unique
  reversedBy        BoxTransfer? @relation("ReverseTransfer", fields: [reversedById], references: [id])
  reversesTransfer  BoxTransfer? @relation("ReverseTransfer")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt
  createdByUserId   String?
  updatedByUserId   String?
}

model IssueTakeBack {
  id               String              @id @default(cuid())
  stage            String
  issueId          String
  date             String
  reason           String
  note             String?
  totalCount       Int                 @default(0)
  totalWeight      Float               @default(0)
  isReverse        Boolean             @default(false)
  isReversed       Boolean             @default(false)
  reversedById     String?             @unique
  reversedBy       IssueTakeBack?      @relation("ReverseIssueTakeBack", fields: [reversedById], references: [id])
  reversesTakeBack IssueTakeBack?      @relation("ReverseIssueTakeBack")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @default(now()) @updatedAt
  createdByUserId  String?
  updatedByUserId  String?
  lines            IssueTakeBackLine[]

  @@index([stage])
  @@index([issueId])
  @@index([stage, issueId])
}

model IssueTakeBackLine {
  id              String        @id @default(cuid())
  takeBackId      String
  sourceId        String
  sourceBarcode   String?
  count           Int           @default(0)
  weight          Float         @default(0)
  meta            Json          @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  takeBack        IssueTakeBack @relation(fields: [takeBackId], references: [id], onDelete: Cascade)

  @@index([takeBackId])
  @@index([sourceId])
}

// ========== BOILER (STEAMING) FEATURE ==========

model BoilerSteamLog {
  id               String   @id @default(cuid())
  barcode          String   @unique // The holo receive row barcode
  holoReceiveRowId String? // Reference to the original receive row
  boilerMachineId  String?
  boilerMachine    Machine? @relation("BoilerSteamLogMachine", fields: [boilerMachineId], references: [id], onDelete: Restrict)
  boilerNumber     Int?
  steamedAt        DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  createdByUserId  String?
  updatedByUserId  String?

  @@index([boilerMachineId])
  @@index([holoReceiveRowId])
}

// ========== WASTAGE EVENTS (mark/revert audit trail with notes) ==========

model WastageEvent {
  id              String   @id @default(cuid())
  stage           String // 'cutter' | 'coning' | 'holo'
  pieceId         String // cutter/holo: InboundItem.id; coning: IssueToConingMachine.id
  eventType       String // 'mark' | 'revert'
  weight          Float    @default(0) // magnitude (sign implied by eventType)
  note            String? // optional, <= 500 chars
  reason          String? // required for revert, <= 200 chars
  reversedEventId String?  @unique // set on revert events; uniqueness guards against double-revert
  holoRowId       String? // for holo only, references ReceiveFromHoloMachineRow.id
  challanId       String? // for cutter only, references ReceiveFromCutterMachineChallan.id
  synthetic       Boolean  @default(false) // true for backfilled legacy mark events
  actorUserId     String?
  actorUsername   String?
  actorRoleKey    String?
  createdAt       DateTime @default(now())

  @@index([stage, pieceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([holoRowId])
  @@index([challanId])
}

// ========== CONTRACTOR KG PAYMENTS FEATURE ==========
// Each process has one current contractor owner, with quality-specific per-KG
// rates. Reports select one production date and settlements snapshot the
// contractor + process + rate inputs for immutable payment history. Money and
// rates are database
// decimals; net KG is stored with three decimals. Quality keys reference
// master IDs by value (resolved in the app layer) to keep rate config
// decoupled from master-record lifecycle.

model Contractor {
  id              String                 @id @default(cuid())
  name            String
  phone           String?
  paymentDetails  String?
  notes           String?
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  assignments     ContractorAssignment[]
  rates           ContractorRate[]
  settlements     ContractorSettlement[]

  @@index([isActive])
}

model ContractorAssignment {
  id              String     @id @default(cuid())
  contractorId    String
  process         String     @unique // 'cutter' | 'holo' | 'coning' — one current owner per process
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  contractor      Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId])
}

model ContractorRate {
  id              String     @id @default(cuid())
  contractorId    String
  process         String // 'cutter' | 'holo' | 'coning'
  // Quality keys (presence depends on process). Stored as master IDs by value.
  itemId          String? // cutter optional override; null means any item
  yarnId          String? // holo, coning (required)
  cutId           String? // optional override; null means any cut
  side            SideType? // coning (required)
  twistId         String? // optional override (holo, coning)
  coneTypeId      String? // optional override (coning)
  ratePerKg       Decimal    @db.Decimal(12, 4)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  contractor      Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId, process])
}

model ContractorSettlement {
  id               String                           @id @default(cuid())
  contractorId     String
  process          String // 'cutter' | 'holo' | 'coning'
  periodFrom       String // selected production period start (YYYY-MM-DD)
  periodTo         String // selected production period end (YYYY-MM-DD)
  status           String                           @default("draft") // 'draft' | 'paid'
  productionKg     Decimal                          @default(0) @db.Decimal(16, 3)
  productionAmount Decimal                          @default(0) @db.Decimal(16, 2)
  adjustmentsTotal Decimal                          @default(0) @db.Decimal(16, 2)
  finalPayable     Decimal                          @default(0) @db.Decimal(16, 2)
  notes            String?
  // Payment metadata (set on Mark Paid)
  paymentDate      String?
  paymentMode      String? // 'Cash' | 'Bank' | 'UPI' | 'Other'
  paymentReference String?
  paymentNotes     String?
  paidAt           DateTime?
  paidByUserId     String?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @default(now()) @updatedAt
  createdByUserId  String?
  updatedByUserId  String?
  contractor       Contractor                       @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  lines            ContractorSettlementLine[]
  adjustments      ContractorSettlementAdjustment[]
  revisions        ContractorSettlementRevision[]

  @@index([contractorId, process])
  @@index([status])
  @@index([process, periodFrom, periodTo])
}

model ContractorSettlementLine {
  id           String               @id @default(cuid())
  settlementId String
  process      String // 'cutter' | 'holo' | 'coning'
  sourceRowId  String // receive-row id claimed by this settlement
  date         String? // YYYY-MM-DD (production date snapshot)
  quantity     Int? // cutter=bobbins, holo=rolls, coning=cones
  netKg        Decimal              @db.Decimal(16, 3)
  ratePerKg    Decimal              @db.Decimal(12, 4)
  amount       Decimal              @db.Decimal(16, 2)
  rateId       String? // matched ContractorRate id (snapshot reference)
  // Quality snapshots (name + id captured at draft time)
  itemId       String?
  itemName     String?
  yarnId       String?
  yarnName     String?
  cutId        String?
  cutName      String?
  twistId      String?
  twistName    String?
  coneTypeId   String?
  coneTypeName String?
  side         SideType?
  barcode      String?
  lotNo        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @default(now()) @updatedAt
  settlement   ContractorSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  // A source row belongs to at most one settlement at a time (drafts + paid).
  // Deleting a draft frees its rows; admin paid-edit removing a line frees it.
  @@unique([process, sourceRowId])
  @@index([settlementId])
}

model ContractorSettlementAdjustment {
  id              String               @id @default(cuid())
  settlementId    String
  type            String // 'bonus' | 'advance_recovery' | 'deduction' | 'other'
  amount          Decimal              @db.Decimal(16, 2) // always positive; sign derived from type
  reason          String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
  settlement      ContractorSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
}

model ContractorSettlementRevision {
  id                String               @id @default(cuid())
  settlementId      String
  revisionNumber    Int
  reason            String
  beforeSnapshot    Json
  afterSnapshot     Json
  previousTotal     Decimal              @db.Decimal(16, 2)
  newTotal          Decimal              @db.Decimal(16, 2)
  delta             Decimal              @db.Decimal(16, 2) // newTotal - previousTotal
  changedByUserId   String?
  changedByUsername String?
  createdAt         DateTime             @default(now())
  settlement        ContractorSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@unique([settlementId, revisionNumber])
  @@index([settlementId])
}

// Combined Stock master: which of the 4 stock views appear in the combined
// item-wise view, and in what order. Rows are fixed/seeded (no create/delete).
model CombinedStockProcessView {
  id              String   @id @default(cuid())
  processKey      String   @unique // 'jumbo' | 'bobbins' | 'holo' | 'coning'
  label           String
  isEnabled       Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
}

// Singleton config for the Combined Stock view.
model CombinedStockConfig {
  id              Int      @id @default(1)
  displayMode     String   @default("summary") // 'summary' | 'full'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  createdByUserId String?
  updatedByUserId String?
}

// Owner-agent records are intentionally separate from human sessions and
// business mutation tables. The agent can only mutate OwnerTask and propose
// AgentLearningCandidate rows through the two-step AgentOperation ledger.
model OwnerTask {
  id               String   @id @default(cuid())
  title            String
  description      String?
  area             String   @default("GENERAL")
  priority         String   @default("MEDIUM")
  status           String   @default("OPEN")
  dueDate          String?
  version          Int      @default(1)
  completedAt      DateTime?
  createdByAgentId String?
  updatedByAgentId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([status, priority])
  @@index([area, status])
  @@index([dueDate])
}

model AgentLearningCandidate {
  id                String   @id @default(cuid())
  category          String
  statement         String
  evidence          String?
  status            String   @default("PROPOSED")
  version           Int      @default(1)
  proposedByAgentId String
  reviewedByUserId  String?
  reviewedAt        DateTime?
  reviewNote        String?
  appliedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([category, status])
}

model AgentOperation {
  id               String   @id @default(uuid())
  agentId          String
  requesterId      String
  channel          String
  sessionKey       String?
  action           String
  entityType       String
  entityId         String?
  status           String   @default("PREPARED")
  idempotencyKey   String
  requestHash      String
  request          Json
  preview          Json
  result           Json?
  verification     Json?
  confirmationHash String
  expiresAt        DateTime
  expectedVersion  Int?
  failureCode      String?
  failureMessage   String?
  executedAt       DateTime?
  verifiedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@unique([agentId, action, idempotencyKey])
  @@index([status, expiresAt])
  @@index([entityType, entityId])
  @@index([requesterId, createdAt])
}

model AgentAccessLog {
  id           String   @id @default(cuid())
  agentId      String
  requesterId  String
  channel      String
  sessionKey   String?
  resource     String
  source       String
  filtersHash  String
  resultCount  Int?
  outcome      String
  durationMs   Int?
  errorCode    String?
  createdAt    DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([resource, createdAt])
  @@index([outcome, createdAt])
}
