[Unit]
Description=GLINTEX Owner OpenClaw Gateway
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=openclaw-glintex
Group=openclaw-glintex
WorkingDirectory=/var/lib/openclaw-glintex
EnvironmentFile=/etc/glintex-owner-openclaw.env
ExecStart=/usr/local/bin/openclaw gateway run
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/openclaw-glintex
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
